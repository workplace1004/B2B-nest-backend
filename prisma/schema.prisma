// HAZEL Executive Inventory Platform - Prisma Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTHENTICATION & USERS
// ============================================

enum UserRole {
  ADMIN
  OPERATIONS
  SALES
  B2B
}

model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  password      String
  firstName     String
  lastName      String
  role          UserRole  @default(B2B)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations
  orders        Order[]
  customers     Customer[] @relation("CustomerOwner")
  auditLogs     AuditLog[]
  
  @@map("users")
}

// ============================================
// PRODUCTS & COLLECTIONS
// ============================================

enum CollectionLifecycle {
  PLANNING
  ACTIVE
  ARCHIVED
  DISCONTINUED
}

model Collection {
  id          Int       @id @default(autoincrement())
  name        String
  season      String?   // e.g., "Spring 2024"
  drop        String?   // e.g., "Drop 1"
  lifecycle   CollectionLifecycle @default(PLANNING)
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Relations
  products    Product[]
  
  @@map("collections")
}

model Product {
  id          Int       @id @default(autoincrement())
  name        String
  sku         String    @unique
  style       String?
  sizes       String[]  // Array of sizes
  colors      String[]  // Array of colors
  materials   String[]  // Array of materials
  ean         String?   @unique
  description String?
  basePrice   Decimal   @default(0)
  collectionId Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Relations
  collection  Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  inventory   Inventory[]
  orderLines  OrderLine[]
  purchaseOrderLines PurchaseOrderLine[]
  damAssets   DAMAsset[]
  forecasts   Forecast[]
  
  @@map("products")
}

// ============================================
// INVENTORY & WAREHOUSES
// ============================================

model Warehouse {
  id          Int       @id @default(autoincrement())
  name        String
  location    String?
  address     String?
  city        String?
  country     String?
  postalCode  String?
  tplReference String?  // 3PL reference
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Relations
  inventory   Inventory[]
  shipments   Shipment[]
  
  @@map("warehouses")
}

model Inventory {
  id          Int       @id @default(autoincrement())
  productId   Int
  warehouseId Int
  quantity    Int       @default(0)
  reservedQty Int       @default(0) // Reserved for orders
  availableQty Int      @default(0) // quantity - reservedQty
  reorderPoint Int      @default(0)
  safetyStock Int       @default(0)
  lastUpdated DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Relations
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  
  @@unique([productId, warehouseId])
  @@map("inventory")
}

// ============================================
// CUSTOMERS & ORDERS
// ============================================

enum CustomerType {
  RETAILER
  B2B
  WHOLESALE
}

model Customer {
  id          Int       @id @default(autoincrement())
  name        String
  email       String?   @unique
  phone       String?
  type        CustomerType @default(B2B)
  companyName String?
  taxId       String?
  address     String?
  city        String?
  country     String?
  postalCode  String?
  creditLimit Decimal?  @default(0)
  isActive    Boolean   @default(true)
  ownerId     Int?      // Sales rep assigned
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Relations
  owner       User?     @relation("CustomerOwner", fields: [ownerId], references: [id])
  orders      Order[]
  
  @@map("customers")
}

enum OrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  PROCESSING
  PARTIALLY_FULFILLED
  FULFILLED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum OrderType {
  B2B
  WHOLESALE
  DTC
}

model Order {
  id          Int       @id @default(autoincrement())
  orderNumber String    @unique
  customerId  Int
  userId      Int?      // Sales rep who created
  type        OrderType @default(B2B)
  status      OrderStatus @default(DRAFT)
  totalAmount Decimal   @default(0)
  currency    String    @default("USD")
  notes       String?
  shippingAddress String?
  billingAddress  String?
  orderDate    DateTime  @default(now())
  requiredDate DateTime?
  shippedDate  DateTime?
  deliveredDate DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Relations
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  user        User?     @relation(fields: [userId], references: [id])
  orderLines  OrderLine[]
  shipments   Shipment[]
  
  @@map("orders")
}

model OrderLine {
  id          Int       @id @default(autoincrement())
  orderId     Int
  productId   Int
  quantity    Int
  unitPrice   Decimal
  totalPrice  Decimal
  size        String?
  color       String?
  fulfilledQty Int     @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Relations
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  
  @@map("order_lines")
}

// ============================================
// SUPPLIERS & PURCHASE ORDERS
// ============================================

model Supplier {
  id          Int       @id @default(autoincrement())
  name        String
  email       String?
  phone       String?
  contactName String?
  address     String?
  city        String?
  country     String?
  postalCode  String?
  leadTimeDays Int?    @default(30) // Average lead time in days
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Relations
  purchaseOrders PurchaseOrder[]
  
  @@map("suppliers")
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  CONFIRMED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id          Int       @id @default(autoincrement())
  poNumber    String    @unique
  supplierId  Int
  status      PurchaseOrderStatus @default(DRAFT)
  totalAmount Decimal   @default(0)
  currency    String    @default("USD")
  orderDate   DateTime  @default(now())
  expectedDate DateTime?
  receivedDate DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Relations
  supplier    Supplier  @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lines       PurchaseOrderLine[]
  
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id          Int       @id @default(autoincrement())
  purchaseOrderId Int
  productId   Int
  quantity    Int
  unitCost    Decimal
  totalCost   Decimal
  receivedQty Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Relations
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  
  @@map("purchase_order_lines")
}

// ============================================
// LOGISTICS & SHIPMENTS
// ============================================

enum ShipmentStatus {
  PENDING
  PICKED
  PACKED
  SHIPPED
  IN_TRANSIT
  DELIVERED
  RETURNED
}

model Shipment {
  id          Int       @id @default(autoincrement())
  shipmentNumber String  @unique
  orderId     Int
  warehouseId Int
  status      ShipmentStatus @default(PENDING)
  carrier     String?
  trackingNumber String?
  shippingCost Decimal?  @default(0)
  shippedDate DateTime?
  deliveredDate DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Relations
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  
  @@map("shipments")
}

// ============================================
// DIGITAL ASSET MANAGEMENT
// ============================================

enum AssetType {
  IMAGE
  VIDEO
  DOCUMENT
  OTHER
}

model DAMAsset {
  id          Int       @id @default(autoincrement())
  productId   Int?
  name        String
  type        AssetType @default(IMAGE)
  url         String
  thumbnailUrl String?
  description String?
  tags        String[]
  fileSize    Int?      // in bytes
  mimeType    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Relations
  product     Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  
  @@map("dam_assets")
}

// ============================================
// FORECASTING & ANALYTICS
// ============================================

model Forecast {
  id          Int       @id @default(autoincrement())
  productId   Int
  size        String?
  period      String    // e.g., "2024-Q1" or "2024-01"
  predictedDemand Int   @default(0)
  confidence  Decimal?  // 0-1 confidence score
  method      String?   // e.g., "AI", "Manual", "Historical"
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Relations
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  @@unique([productId, size, period])
  @@map("forecasts")
}

model ScenarioSimulation {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  scenarioData Json     // Store scenario parameters as JSON
  results     Json?     // Store simulation results as JSON
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@map("scenario_simulations")
}

// ============================================
// FINANCIAL DATA
// ============================================

model FinancialData {
  id          Int       @id @default(autoincrement())
  productId   Int?
  period      String    // e.g., "2024-Q1"
  cogs        Decimal?  // Cost of Goods Sold
  revenue     Decimal?
  margin      Decimal?
  marginPercent Decimal?
  inventoryValue Decimal?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@unique([productId, period])
  @@map("financial_data")
}

// ============================================
// AUDIT LOGS
// ============================================

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  VIEW
  EXPORT
}

model AuditLog {
  id          Int       @id @default(autoincrement())
  userId      Int
  action      AuditAction
  entityType  String    // e.g., "Product", "Order", "Inventory"
  entityId    Int?
  changes     Json?     // Store before/after changes
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())
  
  // Relations
  user        User      @relation(fields: [userId], references: [id])
  
  @@map("audit_logs")
}
