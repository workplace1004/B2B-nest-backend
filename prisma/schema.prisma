// HAZEL Executive Inventory Platform - Prisma Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTHENTICATION & USERS
// ============================================

enum UserRole {
  ADMIN
  OPERATIONS
  SALES
  B2B
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  role      UserRole @default(B2B)
  roleId    Int? // Reference to Role table for granular permissions
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  orders           Order[]
  customers        Customer[]           @relation("CustomerOwner")
  auditLogs        AuditLog[]
  quotes           Quote[]
  proformaInvoices ProformaInvoice[]
  territory        SalesRepTerritory?
  commissions      SalesRepCommission[]
  roleRef          Role?                @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@map("users")
}

// ============================================
// PRODUCTS & COLLECTIONS
// ============================================

enum CollectionLifecycle {
  PLANNING
  ACTIVE
  ARCHIVED
  DISCONTINUED
}

model Collection {
  id          Int                 @id @default(autoincrement())
  name        String
  season      String? // e.g., "Spring 2024"
  drop        String? // e.g., "Drop 1"
  lifecycle   CollectionLifecycle @default(PLANNING)
  description String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  // Relations
  products           Product[]
  campaignEvents     CampaignEvent[]
  featuredCollection FeaturedCollection?

  @@map("collections")
}

model Product {
  id           Int      @id @default(autoincrement())
  name         String
  sku          String   @unique
  style        String?
  sizes        String[] // Array of sizes
  colors       String[] // Array of colors
  materials    String[] // Array of materials
  ean          String?  @unique
  description  String?
  basePrice    Decimal  @default(0)
  price        Decimal? @default(0) // Current selling price
  images       String[] // Array of image URLs (base64 or URLs)
  collectionId Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  collection             Collection              @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  inventory              Inventory[]
  orderLines             OrderLine[]
  purchaseOrderLines     PurchaseOrderLine[]
  damAssets              DAMAsset[]
  forecasts              Forecast[]
  reviews                Review[]
  bom                    BOM?
  bomComponents          BOMComponent[]
  markdownPlans          MarkdownPlan[]
  costSheet              CostSheet?
  pricing                ProductPricing[]
  returns                Return[]
  Replenishment          Replenishment[]
  digitalProductPassport DigitalProductPassport?
  complianceEvidences    ComplianceEvidence[]
  quoteLines             QuoteLine[]
  proformaInvoiceLines   ProformaInvoiceLine[]
  cycleCountItems        CycleCountItem[]
  physicalInventoryItems PhysicalInventoryItem[] @relation("PhysicalInventoryItemProduct")
  preOrders              PreOrder[]              @relation("PreOrderProduct")
  backorders             Backorder[]             @relation("BackorderProduct")
  partialShipmentItems   PartialShipmentItem[]   @relation("PartialShipmentItemProduct")
  scanHistory            ScanHistory[]
  pickListItems          PickListItem[]
  packSlipItems          PackSlipItem[]
  bopisOrderItems        BOPISOrderItem[]        @relation("BOPISProduct")
  borisReturnItems       BORISReturnItem[]       @relation("BORISProduct")
  endlessAisleProducts   EndlessAisleProduct[]   @relation("EndlessAisleProduct")

  @@map("products")
}

// ============================================
// INVENTORY & WAREHOUSES
// ============================================

model Warehouse {
  id           Int      @id @default(autoincrement())
  name         String
  location     String?
  address      String?
  city         String?
  country      String?
  postalCode   String?
  tplReference String? // 3PL reference
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  inventory              Inventory[]
  shipments              Shipment[]
  replenishments         Replenishment[]
  cycleCounts            CycleCount[]
  physicalInventories    PhysicalInventory[]     @relation("PhysicalInventoryWarehouse")
  allocationRules        AllocationRule[]        @relation("AllocationRuleWarehouse")
  scanHistory            ScanHistory[]
  pickLists              PickList[]
  packSlips              PackSlip[]
  endlessAisleWarehouses EndlessAisleWarehouse[] @relation("EndlessAisleWarehouse")

  @@map("warehouses")
}

model Inventory {
  id           Int      @id @default(autoincrement())
  productId    Int
  warehouseId  Int
  quantity     Int      @default(0)
  reservedQty  Int      @default(0) // Reserved for orders
  availableQty Int      @default(0) // quantity - reservedQty
  reorderPoint Int      @default(0)
  safetyStock  Int      @default(0)
  lastUpdated  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
  @@map("inventory")
}

// ============================================
// CUSTOMERS & ORDERS
// ============================================

enum CustomerType {
  RETAILER
  B2B
  WHOLESALE
}

model Customer {
  id            Int          @id @default(autoincrement())
  name          String
  email         String?      @unique
  phone         String?
  contactPerson String? // Contact person name
  type          CustomerType @default(B2B)
  companyName   String?
  taxId         String?
  address       String?
  city          String?
  country       String?
  postalCode    String?
  creditLimit   Decimal?     @default(0)
  isActive      Boolean      @default(true)
  ownerId       Int? // Sales rep assigned
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Relations
  owner            User?             @relation("CustomerOwner", fields: [ownerId], references: [id])
  orders           Order[]
  reviews          Review[]
  quotes           Quote[]
  proformaInvoices ProformaInvoice[]
  creditNotes      CreditNote[]
  allocationRules  AllocationRule[]
  bopisOrders      BOPISOrder[]      @relation("BOPISCustomer")
  borisReturns     BORISReturn[]     @relation("BORISCustomer")
  serviceCases     ServiceCase[]

  @@map("customers")
}

enum OrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  PROCESSING
  PARTIALLY_FULFILLED
  FULFILLED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum OrderType {
  B2B
  WHOLESALE
  DTC
}

model Order {
  id              Int         @id @default(autoincrement())
  orderNumber     String      @unique
  customerId      Int
  userId          Int? // Sales rep who created
  type            OrderType   @default(B2B)
  status          OrderStatus @default(DRAFT)
  totalAmount     Decimal     @default(0)
  currency        String      @default("USD")
  notes           String?
  shippingAddress String?
  billingAddress  String?
  orderDate       DateTime    @default(now())
  requiredDate    DateTime?
  shippedDate     DateTime?
  deliveredDate   DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relations
  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  user             User?             @relation(fields: [userId], references: [id])
  orderLines       OrderLine[]
  shipments        Shipment[]
  returns          Return[]
  quotes           Quote[]
  proformaInvoices ProformaInvoice[]
  preOrders        PreOrder[]
  backorders       Backorder[]       @relation("BackorderOrder")
  partialShipments PartialShipment[] @relation("PartialShipmentOrder")
  landedCost       LandedCost?
  bopisOrders      BOPISOrder[]      @relation("BOPISOrder")
  borisReturns     BORISReturn[]     @relation("BORISOrder")
  pickLists        PickList[]
  packSlips        PackSlip[]
  shippingLabels   ShippingLabel[]

  @@map("orders")
}

model OrderLine {
  id           Int      @id @default(autoincrement())
  orderId      Int
  productId    Int
  quantity     Int
  unitPrice    Decimal
  totalPrice   Decimal
  size         String?
  color        String?
  fulfilledQty Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  order                Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product              Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  preOrders            PreOrder[]
  backorders           Backorder[]           @relation("BackorderOrderLine")
  partialShipmentItems PartialShipmentItem[] @relation("PartialShipmentItemOrderLine")
  pickListItems        PickListItem[]
  packSlipItems        PackSlipItem[]
  bopisOrderItems      BOPISOrderItem[]      @relation("BOPISOrderLine")
  borisReturnItems     BORISReturnItem[]     @relation("BORISOrderLine")

  @@map("order_lines")
}

// ============================================
// SUPPLIERS & PURCHASE ORDERS
// ============================================

model Supplier {
  id           Int      @id @default(autoincrement())
  name         String
  email        String?
  phone        String?
  contactName  String?
  address      String?
  city         String?
  country      String?
  postalCode   String?
  leadTimeDays Int?     @default(30) // Average lead time in days
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  purchaseOrders   PurchaseOrder[]
  priceHistory     SupplierPriceHistory[]
  negotiationNotes SupplierNegotiationNote[]

  @@map("suppliers")
}

model SupplierPriceHistory {
  id          Int      @id @default(autoincrement())
  supplierId  Int
  productId   Int?
  productName String?
  price       Float
  currency    String   @default("USD")
  quantity    Int?
  date        DateTime
  notes       String?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@map("supplier_price_history")
}

model SupplierNegotiationNote {
  id         Int      @id @default(autoincrement())
  supplierId Int
  title      String
  content    String
  date       DateTime
  createdBy  String?
  tags       String[] @default([])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@map("supplier_negotiation_notes")
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  CONFIRMED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id           Int                 @id @default(autoincrement())
  poNumber     String              @unique
  supplierId   Int
  status       PurchaseOrderStatus @default(DRAFT)
  totalAmount  Decimal             @default(0)
  currency     String              @default("USD")
  orderDate    DateTime            @default(now())
  expectedDate DateTime?
  receivedDate DateTime?
  notes        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  // Relations
  supplier    Supplier                   @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lines       PurchaseOrderLine[]
  approvals   PurchaseOrderApproval[]
  wipTracking PurchaseOrderWIPTracking[]
  batches     PurchaseOrderBatch[]
  bom         BOM?                       @relation(fields: [bOMId], references: [id])
  bOMId       Int?

  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id              Int      @id @default(autoincrement())
  purchaseOrderId Int
  productId       Int
  quantity        Int
  unitCost        Decimal
  totalCost       Decimal
  receivedQty     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("purchase_order_lines")
}

model PurchaseOrderApproval {
  id              Int                         @id @default(autoincrement())
  purchaseOrderId Int
  approverId      Int?
  approverName    String
  status          PurchaseOrderApprovalStatus @default(PENDING)
  comments        String?
  date            DateTime                    @default(now())
  level           Int                         @default(1)
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  // Relations
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@map("purchase_order_approvals")
}

enum PurchaseOrderApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model PurchaseOrderWIPTracking {
  id              Int               @id @default(autoincrement())
  purchaseOrderId Int
  stage           String
  quantity        Int
  completedQty    Int               @default(0)
  status          WIPTrackingStatus @default(NOT_STARTED)
  startDate       DateTime?
  completionDate  DateTime?
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relations
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@map("purchase_order_wip_tracking")
}

enum WIPTrackingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

model PurchaseOrderBatch {
  id              Int         @id @default(autoincrement())
  purchaseOrderId Int
  batchNumber     String
  lotNumber       String?
  quantity        Int
  productionDate  DateTime?
  expiryDate      DateTime?
  status          BatchStatus @default(PENDING)
  location        String?
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relations
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@map("purchase_order_batches")
}

enum BatchStatus {
  PENDING
  IN_PRODUCTION
  COMPLETED
  QUARANTINED
}

model LandedCost {
  id                    Int      @id @default(autoincrement())
  orderId               Int
  // Product Costs
  productCost           Decimal  @default(0) // FOB cost
  // Shipping & Logistics
  shippingCost          Decimal  @default(0)
  freightCost           Decimal  @default(0)
  insuranceCost         Decimal  @default(0)
  // Customs & Duties
  customsDuty           Decimal  @default(0)
  customsDutyRate       Decimal? // Percentage
  tariffs               Decimal  @default(0)
  // Port & Handling
  portFees              Decimal  @default(0)
  handlingFees          Decimal  @default(0)
  // Other Costs
  otherCosts            Decimal  @default(0)
  otherCostsDescription String?
  // Totals
  subtotal              Decimal  @default(0) // Sum of all costs
  totalLandedCost       Decimal  @default(0) // Final landed cost
  currency              String   @default("USD")
  // Metadata
  calculatedDate        DateTime @default(now())
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId])
  @@map("landed_costs")
}

model ScanHistory {
  id          String       @id @default(uuid())
  code        String
  codeType    ScanCodeType
  productId   Int?
  warehouseId Int?
  action      ScanAction
  quantity    Int?
  status      ScanStatus
  message     String?
  scannedAt   DateTime     @default(now())
  scannedBy   String?
  metadata    Json?

  // Relations
  product   Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  @@map("scan_history")
}

enum ScanCodeType {
  BARCODE
  QR
  RFID
}

enum ScanAction {
  LOOKUP
  INVENTORY_UPDATE
  TRANSFER
  RECEIVING
  SHIPPING
}

enum ScanStatus {
  SUCCESS
  ERROR
  WARNING
}

model PickList {
  id             String         @id @default(uuid())
  pickListNumber String         @unique
  orderId        Int
  warehouseId    Int
  status         PickListStatus @default(DRAFT)
  assignedTo     String?
  startedAt      DateTime?
  completedAt    DateTime?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Relations
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items     PickListItem[]
  packSlips PackSlip[]

  @@map("pick_lists")
}

enum PickListStatus {
  DRAFT
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model PickListItem {
  id             String         @id @default(uuid())
  pickListId     String
  orderLineId    Int
  productId      Int
  binLocation    String?
  quantity       Int
  pickedQuantity Int            @default(0)
  status         PickItemStatus @default(PENDING)
  pickedBy       String?
  pickedAt       DateTime?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Relations
  pickList  PickList  @relation(fields: [pickListId], references: [id], onDelete: Cascade)
  orderLine OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("pick_list_items")
}

enum PickItemStatus {
  PENDING
  PICKED
  PARTIAL
  SKIPPED
}

model PackSlip {
  id             String         @id @default(uuid())
  packSlipNumber String         @unique
  orderId        Int
  pickListId     String?
  warehouseId    Int
  status         PackSlipStatus @default(DRAFT)
  packedBy       String?
  packedAt       DateTime?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Relations
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  pickList       PickList?       @relation(fields: [pickListId], references: [id], onDelete: SetNull)
  warehouse      Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items          PackSlipItem[]
  shippingLabels ShippingLabel[]

  @@map("pack_slips")
}

enum PackSlipStatus {
  DRAFT
  PACKING
  PACKED
  SHIPPED
  CANCELLED
}

model PackSlipItem {
  id          String   @id @default(uuid())
  packSlipId  String
  orderLineId Int
  productId   Int
  quantity    Int
  packedQty   Int      @default(0)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  packSlip  PackSlip  @relation(fields: [packSlipId], references: [id], onDelete: Cascade)
  orderLine OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("pack_slip_items")
}

model ShippingLabel {
  id             String              @id @default(uuid())
  labelNumber    String              @unique
  orderId        Int
  packSlipId     String?
  carrier        String
  trackingNumber String?
  serviceType    String?
  status         ShippingLabelStatus @default(PENDING)
  weight         Decimal?
  dimensions     String?
  cost           Decimal?
  printedAt      DateTime?
  shippedAt      DateTime?
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  // Relations
  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  packSlip PackSlip? @relation(fields: [packSlipId], references: [id], onDelete: SetNull)

  @@map("shipping_labels")
}

enum ShippingLabelStatus {
  PENDING
  PRINTED
  SHIPPED
  CANCELLED
}

// ============================================
// LOGISTICS & SHIPMENTS
// ============================================

enum ShipmentStatus {
  PENDING
  PICKED
  PACKED
  SHIPPED
  IN_TRANSIT
  DELIVERED
  RETURNED
}

model Shipment {
  id             Int            @id @default(autoincrement())
  shipmentNumber String         @unique
  orderId        Int
  warehouseId    Int
  status         ShipmentStatus @default(PENDING)
  carrier        String?
  trackingNumber String?
  shippingCost   Decimal?       @default(0)
  shippedDate    DateTime?
  deliveredDate  DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Relations
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@map("shipments")
}

// ============================================
// DIGITAL ASSET MANAGEMENT
// ============================================

enum AssetType {
  IMAGE
  VIDEO
  DOCUMENT
  OTHER
}

model DAMAsset {
  id           Int       @id @default(autoincrement())
  productId    Int?
  name         String
  type         AssetType @default(IMAGE)
  url          String
  thumbnailUrl String?
  description  String?
  tags         String[]
  fileSize     Int? // in bytes
  mimeType     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("dam_assets")
}

// ============================================
// FORECASTING & ANALYTICS
// ============================================

model Forecast {
  id              Int      @id @default(autoincrement())
  productId       Int
  size            String?
  period          String // e.g., "2024-Q1" or "2024-01"
  predictedDemand Int      @default(0)
  confidence      Decimal? // 0-1 confidence score
  method          String? // e.g., "AI", "Manual", "Historical"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, size, period])
  @@map("forecasts")
}

// ============================================
// BILL OF MATERIALS (BOM)
// ============================================

enum BOMStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model BOM {
  id          Int       @id @default(autoincrement())
  productId   Int       @unique
  name        String
  status      BOMStatus @default(ACTIVE)
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  components     BOMComponent[]
  purchaseOrders PurchaseOrder[]

  @@map("boms")
}

model BOMComponent {
  id        Int      @id @default(autoincrement())
  bomId     Int
  productId Int? // Component product (if exists)
  name      String
  quantity  Decimal  @default(1)
  unit      String?  @default("pcs")
  cost      Decimal? @default(0)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  bom     BOM      @relation(fields: [bomId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("bom_components")
}

// ============================================
// COST SHEETS
// ============================================

model CostSheet {
  id           Int      @id @default(autoincrement())
  productId    Int      @unique
  materials    Decimal  @default(0) // Materials cost
  labor        Decimal  @default(0) // Labor cost
  overhead     Decimal  @default(0) // Overhead cost
  totalCost    Decimal  @default(0) // Calculated: materials + labor + overhead
  sellingPrice Decimal? @default(0) // Target selling price
  margin       Decimal? // Calculated margin percentage
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("cost_sheets")
}

// ============================================
// RETURNS & RMA
// ============================================

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum ReturnReason {
  DEFECTIVE
  WRONG_SIZE
  NOT_AS_DESCRIBED
  DAMAGED
  CUSTOMER_REQUEST
  OTHER
}

model Return {
  id            Int          @id @default(autoincrement())
  rmaNumber     String       @unique
  orderId       Int
  productId     Int
  orderLineId   Int?
  quantity      Int
  reason        ReturnReason
  reasonDetails String?
  status        ReturnStatus @default(PENDING)
  refundAmount  Decimal?     @default(0)
  notes         String?
  requestedDate DateTime     @default(now())
  approvedDate  DateTime?
  processedDate DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Relations
  order            Order              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product          Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  creditNotes      CreditNote[]
  reverseLogistics ReverseLogistics[]

  @@map("returns")
}

model ReverseLogistics {
  id                    String                 @id @default(uuid())
  rmaId                 Int
  trackingNumber        String?
  carrier               String?
  status                ReverseLogisticsStatus @default(PENDING)
  originName            String?
  originAddress         String?
  originCity            String?
  originState           String?
  originPostalCode      String?
  originCountry         String?
  destinationName       String?
  destinationAddress    String?
  destinationCity       String?
  destinationState      String?
  destinationPostalCode String?
  destinationCountry    String?
  shippedDate           DateTime?
  receivedDate          DateTime?
  inspectedDate         DateTime?
  processedDate         DateTime?
  estimatedDeliveryDate DateTime?
  notes                 String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  // Relations
  rma Return @relation(fields: [rmaId], references: [id], onDelete: Cascade)

  @@map("reverse_logistics")
}

enum ReverseLogisticsStatus {
  PENDING
  IN_TRANSIT
  RECEIVED
  INSPECTED
  PROCESSED
  CANCELLED
}

// ============================================
// QUOTES & PROFORMA INVOICES
// ============================================

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model Quote {
  id              Int         @id @default(autoincrement())
  quoteNumber     String      @unique
  customerId      Int
  orderId         Int?
  userId          Int? // Sales rep who created
  status          QuoteStatus @default(DRAFT)
  validUntil      DateTime?
  subtotal        Decimal     @default(0)
  taxRate         Decimal     @default(0)
  taxAmount       Decimal     @default(0)
  discountPercent Decimal     @default(0)
  discountAmount  Decimal     @default(0)
  totalAmount     Decimal     @default(0)
  currency        String      @default("USD")
  notes           String?
  terms           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  sentAt          DateTime?
  acceptedAt      DateTime?
  rejectedAt      DateTime?

  // Relations
  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order           Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  user            User?            @relation(fields: [userId], references: [id])
  quoteLines      QuoteLine[]
  proformaInvoice ProformaInvoice?

  @@map("quotes")
}

model QuoteLine {
  id          Int      @id @default(autoincrement())
  quoteId     Int
  productId   Int
  quantity    Int
  unitPrice   Decimal
  totalPrice  Decimal
  size        String?
  color       String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  quote   Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("quote_lines")
}

enum ProformaInvoiceStatus {
  DRAFT
  SENT
  PAID
  CANCELLED
}

model ProformaInvoice {
  id              Int                   @id @default(autoincrement())
  invoiceNumber   String                @unique
  quoteId         Int?                  @unique
  orderId         Int?
  customerId      Int
  userId          Int? // Sales rep who created
  status          ProformaInvoiceStatus @default(DRAFT)
  subtotal        Decimal               @default(0)
  taxRate         Decimal               @default(0)
  taxAmount       Decimal               @default(0)
  discountPercent Decimal               @default(0)
  discountAmount  Decimal               @default(0)
  totalAmount     Decimal               @default(0)
  currency        String                @default("USD")
  notes           String?
  terms           String?
  dueDate         DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  sentAt          DateTime?
  paidAt          DateTime?

  // Relations
  customer     Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quote        Quote?                @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  order        Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  user         User?                 @relation(fields: [userId], references: [id])
  invoiceLines ProformaInvoiceLine[]
  creditNotes  CreditNote[]

  @@map("proforma_invoices")
}

model ProformaInvoiceLine {
  id          Int      @id @default(autoincrement())
  invoiceId   Int
  productId   Int
  quantity    Int
  unitPrice   Decimal
  totalPrice  Decimal
  size        String?
  color       String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  invoice ProformaInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("proforma_invoice_lines")
}

// ============================================
// PRICING
// ============================================

model ProductPricing {
  id              Int       @id @default(autoincrement())
  productId       Int
  basePrice       Decimal   @default(0)
  discountPercent Decimal?  @default(0)
  finalPrice      Decimal   @default(0)
  validFrom       DateTime  @default(now())
  validUntil      DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_pricing")
}

// ============================================
