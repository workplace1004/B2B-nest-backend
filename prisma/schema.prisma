// ============================================
// ORGANIZATION SETTINGS - BRANDS & MARKETS
// ============================================

enum BrandStatus {
  ACTIVE
  INACTIVE
}

enum MarketStatus {
  ACTIVE
  INACTIVE
}

model Brand {
  id          Int         @id @default(autoincrement())
  name        String
  code        String      @unique
  description String?
  logo        String?
  status      BrandStatus @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relations
  brandMarkets BrandMarket[]

  @@map("brands")
}

model Market {
  id        Int          @id @default(autoincrement())
  name      String
  code      String       @unique
  region    String?
  country   String
  currency  String
  language  String
  timezone  String
  status    MarketStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // Relations
  brandMarkets           BrandMarket[]
  localizations          Localization[]
  marketCurrencySettings MarketCurrencySetting[]

  @@map("markets")
}

// Many-to-many relationship between Brand and Market
model BrandMarket {
  id        Int      @id @default(autoincrement())
  brandId   Int
  marketId  Int
  createdAt DateTime @default(now())

  // Relations
  brand  Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@unique([brandId, marketId])
  @@map("brand_markets")
}

