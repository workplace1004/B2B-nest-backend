  ACCOUNTING
  SHIPPING
  MARKETING
  ANALYTICS
  OTHER
}

enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
  PENDING
  ERROR
}

model Integration {
  id        Int               @id @default(autoincrement())
  name      String
  type      IntegrationType
  status    IntegrationStatus @default(DISCONNECTED)
  apiKey    String? // Encrypted
  apiSecret String? // Encrypted
  config    Json? // Additional configuration
  lastSync  DateTime?
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@map("integrations")
}

enum VismaMappingStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum VismaSyncDirection {
  EXPORT
  IMPORT
  BIDIRECTIONAL
}

enum VismaTransformation {
  NONE
  UPPERCASE
  LOWERCASE
  TRIM
}

model VismaMapping {
  id             Int                  @id @default(autoincrement())
  name            String
  sourceField     String
  targetField     String
  syncDirection   VismaSyncDirection   @default(BIDIRECTIONAL)
  transformation  VismaTransformation @default(NONE)
  status          VismaMappingStatus  @default(PENDING)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@map("visma_mappings")
}

enum SyncLogStatus {
  SUCCESS
  FAILED
  IN_PROGRESS
  PENDING
}

enum SyncLogType {
  FULL
  INCREMENTAL
  MAPPING
}

model SyncLog {
  id              Int            @id @default(autoincrement())
  syncType        SyncLogType     @default(FULL)
  status          SyncLogStatus   @default(PENDING)
  mappingId       Int?
  recordsProcessed Int            @default(0)
  recordsFailed   Int             @default(0)
  startedAt       DateTime        @default(now())
  completedAt     DateTime?
  errorMessage    String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status])
  @@index([startedAt])
  @@index([mappingId])
  @@map("sync_logs")
}

// ============================================
// BUSINESS RULES
// ============================================

enum RuleType {
  INVENTORY
  PRICING
  ORDER
  ALERT
  AUTOMATION
  OTHER
}

enum RuleStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

model Rule {
  id          Int        @id @default(autoincrement())
  name        String
  type        RuleType
  status      RuleStatus @default(ACTIVE)
  description String?
  conditions  Json // Rule conditions as JSON
  actions     Json // Rule actions as JSON
  priority    Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("rules")
}

// ============================================
// ALERTS
// ============================================

enum AlertType {
  LOW_STOCK
  HIGH_STOCK
  ORDER_DELAY
  PAYMENT_ISSUE
  SYSTEM_ERROR
  CUSTOM
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  NEW
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

model Alert {
  id             Int           @id @default(autoincrement())
  type           AlertType
  severity       AlertSeverity @default(MEDIUM)
  status         AlertStatus   @default(NEW)
  title          String
  message        String
  entityType     String? // e.g., "Product", "Order", "Inventory"
  entityId       Int?
  metadata       Json? // Additional alert data
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("alerts")
}

// ============================================
// EXCEPTIONS
// ============================================

enum ExceptionType {
  INVENTORY_MISMATCH
  ORDER_PROCESSING_DELAY
  SHIPMENT_DELAY
  PAYMENT_FAILURE
  DATA_INCONSISTENCY
  SYSTEM_ERROR
  CUSTOM
}

enum ExceptionStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Exception {
  id         Int             @id @default(autoincrement())
  type       ExceptionType
  status     ExceptionStatus @default(OPEN)
  title      String
  message    String
  location   String? // e.g., "Warehouse 1", "Order #123"
  entityType String? // e.g., "Product", "Order", "Inventory"
  entityId   Int?
  metadata   Json? // Additional exception data
  resolvedAt DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@map("exceptions")
}

// ============================================
// REPLENISHMENT
// ============================================

enum ReplenishmentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Replenishment {
