  @@map("tax_defaults")
}

enum WarehouseDefaultStatus {
  ACTIVE
  INACTIVE
}

model WarehouseDefault {
  id          Int                    @id @default(autoincrement())
  name        String
  code        String                 @unique
  address     String
  city        String
  state       String?
  country     String
  postalCode  String
  isDefault   Boolean                @default(false)
  status      WarehouseDefaultStatus @default(ACTIVE)
  capacity    Int?
  description String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@map("warehouse_defaults")
}

// ============================================
// ROLES & PERMISSIONS
// ============================================

model Role {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  description  String?
  permissions  String[] // Array of permission strings (e.g., ["inventory:view", "orders:create"])
  isSystemRole Boolean  @default(false) // System roles cannot be deleted
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  users User[]

  @@map("roles")
}

// ============================================
// DATA IMPORTS & EXPORTS
// ============================================

enum DataImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum DataImportType {
  PRODUCTS
  ORDERS
  CUSTOMERS
  INVENTORY
  CUSTOM
}

model DataImport {
  id               Int              @id @default(autoincrement())
  fileName         String
  type             DataImportType   @default(CUSTOM)
  status           DataImportStatus @default(PENDING)
  recordsTotal     Int              @default(0)
  recordsProcessed Int              @default(0)
  recordsFailed    Int              @default(0)
  uploadedBy       String // User email or name
  uploadedAt       DateTime         @default(now())
  completedAt      DateTime?
  errorMessage     String?
  fileUrl          String? // Path to uploaded file
  filePath         String? // Server file path
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@map("data_imports")
}

enum DataExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum DataExportType {
  PRODUCTS
  ORDERS
  CUSTOMERS
  INVENTORY
  CUSTOM
}

enum DataExportFormat {
  CSV
  EXCEL
}

model DataExport {
  id           Int              @id @default(autoincrement())
  name         String
  format       DataExportFormat @default(CSV)
  type         DataExportType   @default(CUSTOM)
  status       DataExportStatus @default(PENDING)
  recordsCount Int              @default(0)
  fileSize     Int? // File size in bytes
  createdBy    String // User email or name
  createdAt    DateTime         @default(now())
  completedAt  DateTime?
  errorMessage String?
  fileUrl      String? // Path to exported file
  filePath     String? // Server file path
  updatedAt    DateTime         @updatedAt

  @@map("data_exports")
}

// ============================================
// FX RATES & CURRENCY SETTINGS
// ============================================

model FxRate {
  id            Int      @id @default(autoincrement())
  fromCurrency  String
  toCurrency    String
  rate          Decimal  @db.Decimal(18, 6)
  previousRate  Decimal? @db.Decimal(18, 6)
  change        Decimal? @db.Decimal(18, 6)
  changePercent Decimal? @db.Decimal(10, 4)
  source        String   @default("API")
  lastUpdated   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([fromCurrency, toCurrency])
  @@index([fromCurrency])
  @@index([toCurrency])
  @@map("fx_rates")
}

model MarketCurrencySetting {
  id                  Int      @id @default(autoincrement())
  marketId            Int?
  marketName          String
  marketCode          String
  region              String?
  defaultCurrency     String
  supportedCurrencies String[] // Array of currency codes
  autoUpdateRates     Boolean  @default(true)
  isActive            Boolean  @default(true)
  roundingPrecision   Int      @default(2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  market Market? @relation(fields: [marketId], references: [id], onDelete: SetNull)

  @@unique([marketCode])
  @@index([marketId])
  @@map("market_currency_settings")
}

model CreditNote {
  id               Int              @id @default(autoincrement())
  creditNoteNumber String           @unique
  invoiceId        Int?
  returnId         Int?
  customerId       Int
  amount           Decimal          @db.Decimal(18, 2)
  currency         String           @default("USD")
  reason           String?
  status           CreditNoteStatus @default(DRAFT)
  issuedDate       DateTime?
  appliedDate      DateTime?
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // Relations
  invoice  ProformaInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  return   Return?          @relation(fields: [returnId], references: [id], onDelete: SetNull)
  customer Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@index([invoiceId])
  @@index([returnId])
  @@index([status])
  @@map("credit_notes")
}

enum CreditNoteStatus {
  DRAFT
  ISSUED
  APPLIED
  CANCELLED
}

// ============================================
// COUNTING - CYCLE COUNTS & PHYSICAL INVENTORY
// ============================================

enum CycleCountType {
  ABC
  FULL
  RANDOM
  LOCATION_BASED
}

enum CycleCountStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CycleCountItemStatus {
  PENDING
  COUNTED
  VERIFIED
  DISCREPANCY
}

model CycleCount {
  id            Int              @id @default(autoincrement())
  countNumber   String           @unique
  warehouseId   Int
  countType     CycleCountType
  status        CycleCountStatus @default(DRAFT)
  scheduledDate DateTime
  startDate     DateTime?
  completedDate DateTime?
  assignedTo    String?
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  // Relations
  warehouse Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  items     CycleCountItem[]

  @@map("cycle_counts")
}

model CycleCountItem {
  id              Int                  @id @default(autoincrement())
  cycleCountId    Int
  productId       Int
  productName     String?
  sku             String?
  binLocation     String?
  systemQuantity  Int                  @default(0)
  countedQuantity Int?
  variance        Int?
  variancePercent Decimal?
  status          CycleCountItemStatus @default(PENDING)
  countedBy       String?
  countedAt       DateTime?
  notes           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  // Relations
  cycleCount CycleCount @relation(fields: [cycleCountId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("cycle_count_items")
}

enum PhysicalInventoryStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PhysicalInventoryItemStatus {
  PENDING
  COUNTED
  VERIFIED
  DISCREPANCY
}

model PhysicalInventory {
  id              Int                     @id @default(autoincrement())
  inventoryNumber String                  @unique
  warehouseId     Int
  status          PhysicalInventoryStatus @default(DRAFT)
  scheduledDate   DateTime
  startDate       DateTime?
  completedDate   DateTime?
  assignedTo      String?
  notes           String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  // Relations
  warehouse Warehouse               @relation("PhysicalInventoryWarehouse", fields: [warehouseId], references: [id], onDelete: Cascade)
  items     PhysicalInventoryItem[]

  @@map("physical_inventories")
}

model PhysicalInventoryItem {
  id                  Int                         @id @default(autoincrement())
  physicalInventoryId Int
  productId           Int
  productName         String?
  sku                 String?
  binLocation         String?
  systemQuantity      Int                         @default(0)
  countedQuantity     Int?
  variance            Int?
  variancePercent     Decimal?
  status              PhysicalInventoryItemStatus @default(PENDING)
  countedBy           String?
  countedAt           DateTime?
  notes               String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  // Relations
  physicalInventory PhysicalInventory @relation(fields: [physicalInventoryId], references: [id], onDelete: Cascade)
  product           Product           @relation("PhysicalInventoryItemProduct", fields: [productId], references: [id], onDelete: Restrict)

  @@map("physical_inventory_items")
}

// ============================================
// ORDERS - ALLOCATION RULES, PRE-ORDERS, BACKORDERS, PARTIAL SHIPMENTS
// ============================================

enum AllocationMethod {
  FIFO
  LIFO
  PRIORITY
  ROUND_ROBIN
  PROXIMITY
}

enum AllocationChannel {
  DTC
  POS
  B2B
  WHOLESALE
  ALL
}

model AllocationRule {
  id               Int               @id @default(autoincrement())
  name             String
  priority         Int               @default(0)
  channel          AllocationChannel @default(ALL)
  customerId       Int?
  customerType     CustomerType?
  warehouseId      Int?
  allocationMethod AllocationMethod  @default(FIFO)
  conditions       Json? // Conditions as JSON: { minOrderValue, maxOrderValue, productCategory, orderType[] }
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  // Relations
  customer  Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  warehouse Warehouse? @relation("AllocationRuleWarehouse", fields: [warehouseId], references: [id], onDelete: SetNull)

  @@map("allocation_rules")
}

enum PreOrderStatus {
  PENDING
  CONFIRMED
  FULFILLED
  CANCELLED
}

model PreOrder {
  id           Int            @id @default(autoincrement())
  orderId      Int
  orderLineId  Int?
  productId    Int
  quantity     Int
  expectedDate DateTime?
  status       PreOrderStatus @default(PENDING)
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  // Relations
  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderLine OrderLine? @relation(fields: [orderLineId], references: [id], onDelete: SetNull)
  product   Product    @relation("PreOrderProduct", fields: [productId], references: [id], onDelete: Restrict)

  @@map("pre_orders")
}

enum BackorderStatus {
  PENDING
  ALLOCATED
  FULFILLED
  CANCELLED
}

model Backorder {
  id           Int             @id @default(autoincrement())
  orderId      Int
  orderLineId  Int
  productId    Int
  quantity     Int
  status       BackorderStatus @default(PENDING)
  allocatedQty Int             @default(0)
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  // Relations
  order     Order     @relation("BackorderOrder", fields: [orderId], references: [id], onDelete: Cascade)
  orderLine OrderLine @relation("BackorderOrderLine", fields: [orderLineId], references: [id], onDelete: Cascade)
  product   Product   @relation("BackorderProduct", fields: [productId], references: [id], onDelete: Restrict)

  @@map("backorders")
}

enum PartialShipmentStatus {
  PENDING
  SHIPPED
  DELIVERED
  CANCELLED
}

model PartialShipment {
  id             Int                   @id @default(autoincrement())
  orderId        Int
  shipmentNumber String                @unique
  status         PartialShipmentStatus @default(PENDING)
  shippedDate    DateTime?
  deliveredDate  DateTime?
  trackingNumber String?
  carrier        String?
  notes          String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  // Relations
  order Order                 @relation("PartialShipmentOrder", fields: [orderId], references: [id], onDelete: Cascade)
  items PartialShipmentItem[]

  @@map("partial_shipments")
}

model PartialShipmentItem {
  id                Int      @id @default(autoincrement())
  partialShipmentId Int
  orderLineId       Int
  productId         Int
  quantity          Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  partialShipment PartialShipment @relation(fields: [partialShipmentId], references: [id], onDelete: Cascade)
  orderLine       OrderLine       @relation("PartialShipmentItemOrderLine", fields: [orderLineId], references: [id], onDelete: Restrict)
  product         Product         @relation("PartialShipmentItemProduct", fields: [productId], references: [id], onDelete: Restrict)

  @@map("partial_shipment_items")
}

// ============================================
// OMNICHANNEL
// ============================================

enum BOPISOrderStatus {
  PENDING
  READY_FOR_PICKUP
  PICKED_UP
  CANCELLED
  EXPIRED
}

model BOPISOrder {
  id                 Int              @id @default(autoincrement())
  orderId            Int
  orderNumber        String
  customerId         Int
  storeId            Int
  status             BOPISOrderStatus @default(PENDING)
  orderDate          DateTime         @default(now())
  readyForPickupDate DateTime?
  pickedUpDate       DateTime?
  expiryDate         DateTime?
  pickupInstructions String?
  customerNotes      String?
  totalAmount        Decimal          @default(0)
  currency           String           @default("USD")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  // Relations
  order    Order            @relation("BOPISOrder", fields: [orderId], references: [id], onDelete: Restrict)
  customer Customer         @relation("BOPISCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  store    Store            @relation(fields: [storeId], references: [id], onDelete: Restrict)
  items    BOPISOrderItem[]

  @@map("bopis_orders")
}

model BOPISOrderItem {
  id           Int       @id @default(autoincrement())
  bopisOrderId Int
  orderLineId  Int
  productId    Int
  quantity     Int
  unitPrice    Decimal   @default(0)
  totalPrice   Decimal   @default(0)
  size         String?
  color        String?
  isReady      Boolean   @default(false)
  readyAt      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  bopisOrder BOPISOrder @relation(fields: [bopisOrderId], references: [id], onDelete: Cascade)
  orderLine  OrderLine  @relation("BOPISOrderLine", fields: [orderLineId], references: [id], onDelete: Restrict)
  product    Product    @relation("BOPISProduct", fields: [productId], references: [id], onDelete: Restrict)

  @@map("bopis_order_items")
}

enum BORISReturnStatus {
  PENDING
  IN_TRANSIT
  RECEIVED
  PROCESSED
  REJECTED
  CANCELLED
}

model BORISReturn {
  id            Int               @id @default(autoincrement())
  returnId      Int
  returnNumber  String            @unique
  orderId       Int
  customerId    Int
  storeId       Int
  status        BORISReturnStatus @default(PENDING)
  returnDate    DateTime          @default(now())
  receivedDate  DateTime?
  processedDate DateTime?
  reason        String
  refundAmount  Decimal           @default(0)
  currency      String            @default("USD")
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  // Relations
  order    Order             @relation("BORISOrder", fields: [orderId], references: [id], onDelete: Restrict)
  customer Customer          @relation("BORISCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  store    Store             @relation(fields: [storeId], references: [id], onDelete: Restrict)
  items    BORISReturnItem[]

  @@map("boris_returns")
}

enum ItemCondition {
  NEW
  USED
  DAMAGED
  DEFECTIVE
}

model BORISReturnItem {
  id            Int           @id @default(autoincrement())
  borisReturnId Int
  orderLineId   Int
  productId     Int
  quantity      Int
  condition     ItemCondition @default(NEW)
  refundAmount  Decimal       @default(0)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  borisReturn BORISReturn @relation(fields: [borisReturnId], references: [id], onDelete: Cascade)
  orderLine   OrderLine   @relation("BORISOrderLine", fields: [orderLineId], references: [id], onDelete: Restrict)
  product     Product     @relation("BORISProduct", fields: [productId], references: [id], onDelete: Restrict)

  @@map("boris_return_items")
}

model EndlessAisleProduct {
  id                    Int      @id @default(autoincrement())
  productId             Int
  basePrice             Decimal  @default(0)
  currency              String   @default("USD")
  estimatedShippingDays Int      @default(3)
  isAvailable           Boolean  @default(true)
  category              String?
  collection            String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  product               Product                 @relation("EndlessAisleProduct", fields: [productId], references: [id], onDelete: Cascade)
  availableAtWarehouses EndlessAisleWarehouse[]

  @@map("endless_aisle_products")
}

model EndlessAisleWarehouse {
  id                    Int      @id @default(autoincrement())
  endlessAisleProductId Int
  warehouseId           Int
  availableQuantity     Int      @default(0)
  estimatedShippingDays Int      @default(3)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  endlessAisleProduct EndlessAisleProduct @relation(fields: [endlessAisleProductId], references: [id], onDelete: Cascade)
  warehouse           Warehouse           @relation("EndlessAisleWarehouse", fields: [warehouseId], references: [id], onDelete: Restrict)

  @@map("endless_aisle_warehouses")
}

model Store {
  id             Int      @id @default(autoincrement())
  name           String
  code           String?  @unique
  address        String?
  city           String?
  country        String?
  postalCode     String?
  phone          String?
  email          String?
  isActive       Boolean  @default(true)
  operatingHours Json? // Store operating hours as JSON
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  bopisOrders  BOPISOrder[]
  borisReturns BORISReturn[]

  @@map("stores")
}

// ============================================
// MARKETING
// ============================================

enum CampaignEventType {
  DROP
  LAUNCH
  PROMO
}

model CampaignEvent {
  id          Int                @id @default(autoincrement())
  name        String
  date        DateTime
  type        CampaignEventType
  description String?
  status      String?
  collectionId Int?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  // Relations
  collection  Collection?        @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  @@map("campaign_events")
}

model FeaturedCollection {
  id           Int       @id @default(autoincrement())
  collectionId Int       @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@map("featured_collections")
}

model MarkdownPlan {
  id              Int      @id @default(autoincrement())
  productId       Int
  discountPercent Decimal
  newPrice        Decimal
  startDate       DateTime
  endDate         DateTime?
  reason          String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("markdown_plans")
}
