model SizeChart {
  id           Int      @id @default(autoincrement())
  name         String
  category     String? // e.g., "Tops", "Bottoms", "Shoes", "Accessories"
  description  String?
  measurements Json // Store size measurements as JSON: { "XS": { "Chest": "34", "Waist": "28", ... }, "S": {...}, ... }
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("size_charts")
}

// ============================================
// SUSTAINABILITY & COMPLIANCE
// ============================================

model DigitalProductPassport {
  id                   Int       @id @default(autoincrement())
  productId            Int       @unique
  passportId           String?   @unique // Unique passport identifier
  manufacturerName     String?
  manufacturerAddress  String?
  countryOfOrigin      String?
  productionDate       DateTime?
  materials            Json? // Array of materials with percentages: [{ "name": "Cotton", "percentage": 60 }, ...]
  carbonFootprint      Decimal? // CO2 equivalent in kg
  waterFootprint       Decimal? // Water usage in liters
  recyclability        String? // e.g., "Fully Recyclable", "Partially Recyclable", "Not Recyclable"
  repairability        String? // e.g., "Easy", "Moderate", "Difficult"
  careInstructions     String?
  disposalInstructions String?
  traceabilityData     Json? // Supply chain traceability information
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("digital_product_passports")
}

enum ComplianceEvidenceType {
  CERTIFICATION
  TEST_REPORT
  MATERIAL_SAFETY
  ENVIRONMENTAL_IMPACT
  SUPPLY_CHAIN
  OTHER
}

model ComplianceEvidence {
