enum CommissionType {
  SALES_VOLUME
  MARGIN
  HYBRID
}

enum CommissionStatus {
  PENDING
  CALCULATED
  APPROVED
  PAID
}

model SalesRepCommission {
  id               Int              @id @default(autoincrement())
