// HAZEL Executive Inventory Platform - Prisma Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTHENTICATION & USERS
// ============================================

enum UserRole {
  ADMIN
  OPERATIONS
  SALES
  B2B
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  role      UserRole @default(B2B)
  roleId    Int?     // Reference to Role table for granular permissions
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  orders    Order[]
  customers Customer[] @relation("CustomerOwner")
  auditLogs AuditLog[]
  quotes    Quote[]
  proformaInvoices ProformaInvoice[]
  territory SalesRepTerritory?
  commissions SalesRepCommission[]
  roleRef   Role?    @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@map("users")
}

// ============================================
// PRODUCTS & COLLECTIONS
// ============================================

enum CollectionLifecycle {
  PLANNING
  ACTIVE
  ARCHIVED
  DISCONTINUED
}

model Collection {
  id          Int                 @id @default(autoincrement())
  name        String
  season      String? // e.g., "Spring 2024"
  drop        String? // e.g., "Drop 1"
  lifecycle   CollectionLifecycle @default(PLANNING)
  description String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  // Relations
  products Product[]

  @@map("collections")
}

model Product {
  id           Int      @id @default(autoincrement())
  name         String
  sku          String   @unique
  style        String?
  sizes        String[] // Array of sizes
  colors       String[] // Array of colors
  materials    String[] // Array of materials
  ean          String?  @unique
  description  String?
  basePrice    Decimal  @default(0)
  price        Decimal? @default(0) // Current selling price
  images       String[] // Array of image URLs (base64 or URLs)
  collectionId Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  collection         Collection          @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  inventory          Inventory[]
  orderLines         OrderLine[]
  purchaseOrderLines PurchaseOrderLine[]
  damAssets          DAMAsset[]
  forecasts          Forecast[]
  reviews            Review[]
  bom                BOM?
  bomComponents      BOMComponent[]
  costSheet          CostSheet?
  pricing            ProductPricing[]
  returns            Return[]
  Replenishment      Replenishment[]
  digitalProductPassport DigitalProductPassport?
  complianceEvidences   ComplianceEvidence[]
  quoteLines         QuoteLine[]
  proformaInvoiceLines ProformaInvoiceLine[]

  @@map("products")
}

// ============================================
// INVENTORY & WAREHOUSES
// ============================================

model Warehouse {
  id           Int      @id @default(autoincrement())
  name         String
  location     String?
  address      String?
  city         String?
  country      String?
  postalCode   String?
  tplReference String? // 3PL reference
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  inventory      Inventory[]
  shipments      Shipment[]
  replenishments Replenishment[]

  @@map("warehouses")
}

model Inventory {
  id           Int      @id @default(autoincrement())
  productId    Int
  warehouseId  Int
  quantity     Int      @default(0)
  reservedQty  Int      @default(0) // Reserved for orders
  availableQty Int      @default(0) // quantity - reservedQty
  reorderPoint Int      @default(0)
  safetyStock  Int      @default(0)
  lastUpdated  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
  @@map("inventory")
}

// ============================================
// CUSTOMERS & ORDERS
// ============================================

enum CustomerType {
  RETAILER
  B2B
  WHOLESALE
}

model Customer {
  id            Int          @id @default(autoincrement())
  name          String
  email         String?      @unique
  phone         String?
  contactPerson String? // Contact person name
  type          CustomerType @default(B2B)
  companyName   String?
  taxId         String?
  address       String?
  city          String?
  country       String?
  postalCode    String?
  creditLimit   Decimal?     @default(0)
  isActive      Boolean      @default(true)
  ownerId       Int? // Sales rep assigned
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Relations
  owner   User?    @relation("CustomerOwner", fields: [ownerId], references: [id])
  orders  Order[]
  reviews Review[]
  quotes  Quote[]
  proformaInvoices ProformaInvoice[]

  @@map("customers")
}

enum OrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  PROCESSING
  PARTIALLY_FULFILLED
  FULFILLED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum OrderType {
  B2B
  WHOLESALE
  DTC
}

model Order {
  id              Int         @id @default(autoincrement())
  orderNumber     String      @unique
  customerId      Int
  userId          Int? // Sales rep who created
  type            OrderType   @default(B2B)
  status          OrderStatus @default(DRAFT)
  totalAmount     Decimal     @default(0)
  currency        String      @default("USD")
  notes           String?
  shippingAddress String?
  billingAddress  String?
  orderDate       DateTime    @default(now())
  requiredDate    DateTime?
  shippedDate     DateTime?
  deliveredDate   DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relations
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  user       User?       @relation(fields: [userId], references: [id])
  orderLines OrderLine[]
  shipments  Shipment[]
  returns    Return[]
  quotes     Quote[]
  proformaInvoices ProformaInvoice[]

  @@map("orders")
}

model OrderLine {
  id           Int      @id @default(autoincrement())
  orderId      Int
  productId    Int
  quantity     Int
  unitPrice    Decimal
  totalPrice   Decimal
  size         String?
  color        String?
  fulfilledQty Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("order_lines")
}

// ============================================
// SUPPLIERS & PURCHASE ORDERS
// ============================================

model Supplier {
  id           Int      @id @default(autoincrement())
  name         String
  email        String?
  phone        String?
  contactName  String?
  address      String?
  city         String?
  country      String?
  postalCode   String?
  leadTimeDays Int?     @default(30) // Average lead time in days
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  CONFIRMED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id           Int                 @id @default(autoincrement())
  poNumber     String              @unique
  supplierId   Int
  status       PurchaseOrderStatus @default(DRAFT)
  totalAmount  Decimal             @default(0)
  currency     String              @default("USD")
  orderDate    DateTime            @default(now())
  expectedDate DateTime?
  receivedDate DateTime?
  notes        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  // Relations
  supplier Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lines    PurchaseOrderLine[]

  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id              Int      @id @default(autoincrement())
  purchaseOrderId Int
  productId       Int
  quantity        Int
  unitCost        Decimal
  totalCost       Decimal
  receivedQty     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("purchase_order_lines")
}

// ============================================
// LOGISTICS & SHIPMENTS
// ============================================

enum ShipmentStatus {
  PENDING
  PICKED
  PACKED
  SHIPPED
  IN_TRANSIT
  DELIVERED
  RETURNED
}

model Shipment {
  id             Int            @id @default(autoincrement())
  shipmentNumber String         @unique
  orderId        Int
  warehouseId    Int
  status         ShipmentStatus @default(PENDING)
  carrier        String?
  trackingNumber String?
  shippingCost   Decimal?       @default(0)
  shippedDate    DateTime?
  deliveredDate  DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Relations
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@map("shipments")
}

// ============================================
// DIGITAL ASSET MANAGEMENT
// ============================================

enum AssetType {
  IMAGE
  VIDEO
  DOCUMENT
  OTHER
}

model DAMAsset {
  id           Int       @id @default(autoincrement())
  productId    Int?
  name         String
  type         AssetType @default(IMAGE)
  url          String
  thumbnailUrl String?
  description  String?
  tags         String[]
  fileSize     Int? // in bytes
  mimeType     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("dam_assets")
}

// ============================================
// FORECASTING & ANALYTICS
// ============================================

model Forecast {
  id              Int      @id @default(autoincrement())
  productId       Int
  size            String?
  period          String // e.g., "2024-Q1" or "2024-01"
  predictedDemand Int      @default(0)
  confidence      Decimal? // 0-1 confidence score
  method          String? // e.g., "AI", "Manual", "Historical"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, size, period])
  @@map("forecasts")
}

// ============================================
// BILL OF MATERIALS (BOM)
// ============================================

enum BOMStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model BOM {
  id          Int       @id @default(autoincrement())
  productId   Int       @unique
  name        String
  status      BOMStatus @default(ACTIVE)
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  components BOMComponent[]

  @@map("boms")
}

model BOMComponent {
  id        Int      @id @default(autoincrement())
  bomId     Int
  productId Int? // Component product (if exists)
  name      String
  quantity  Decimal  @default(1)
  unit      String?  @default("pcs")
  cost      Decimal? @default(0)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  bom     BOM      @relation(fields: [bomId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("bom_components")
}

// ============================================
// COST SHEETS
// ============================================

model CostSheet {
  id           Int      @id @default(autoincrement())
  productId    Int      @unique
  materials    Decimal  @default(0) // Materials cost
  labor        Decimal  @default(0) // Labor cost
  overhead     Decimal  @default(0) // Overhead cost
  totalCost    Decimal  @default(0) // Calculated: materials + labor + overhead
  sellingPrice Decimal? @default(0) // Target selling price
  margin       Decimal? // Calculated margin percentage
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("cost_sheets")
}

// ============================================
// RETURNS & RMA
// ============================================

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum ReturnReason {
  DEFECTIVE
  WRONG_SIZE
  NOT_AS_DESCRIBED
  DAMAGED
  CUSTOMER_REQUEST
  OTHER
}

model Return {
  id            Int          @id @default(autoincrement())
  rmaNumber     String       @unique
  orderId       Int
  productId     Int
  orderLineId   Int?
  quantity      Int
  reason        ReturnReason
  reasonDetails String?
  status        ReturnStatus @default(PENDING)
  refundAmount  Decimal?     @default(0)
  notes         String?
  requestedDate DateTime     @default(now())
  approvedDate  DateTime?
  processedDate DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Relations
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("returns")
}

// ============================================
// QUOTES & PROFORMA INVOICES
// ============================================

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model Quote {
  id              Int         @id @default(autoincrement())
  quoteNumber     String      @unique
  customerId      Int
  orderId         Int?
  userId          Int? // Sales rep who created
  status          QuoteStatus @default(DRAFT)
  validUntil      DateTime?
  subtotal        Decimal     @default(0)
  taxRate         Decimal     @default(0)
  taxAmount       Decimal     @default(0)
  discountPercent Decimal     @default(0)
  discountAmount  Decimal     @default(0)
  totalAmount     Decimal     @default(0)
  currency        String      @default("USD")
  notes           String?
  terms           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  sentAt          DateTime?
  acceptedAt      DateTime?
  rejectedAt      DateTime?

  // Relations
  customer   Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order      Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  user       User?            @relation(fields: [userId], references: [id])
  quoteLines QuoteLine[]
  proformaInvoice ProformaInvoice?

  @@map("quotes")
}

model QuoteLine {
  id          Int      @id @default(autoincrement())
  quoteId     Int
  productId   Int
  quantity    Int
  unitPrice   Decimal
  totalPrice  Decimal
  size        String?
  color       String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  quote   Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("quote_lines")
}

enum ProformaInvoiceStatus {
  DRAFT
  SENT
  PAID
  CANCELLED
}

model ProformaInvoice {
  id              Int                    @id @default(autoincrement())
  invoiceNumber   String                 @unique
  quoteId         Int?                   @unique
  orderId         Int?
  customerId      Int
  userId          Int? // Sales rep who created
  status          ProformaInvoiceStatus  @default(DRAFT)
  subtotal        Decimal                @default(0)
  taxRate         Decimal                @default(0)
  taxAmount       Decimal                @default(0)
  discountPercent Decimal                @default(0)
  discountAmount  Decimal                @default(0)
  totalAmount     Decimal                @default(0)
  currency        String                 @default("USD")
  notes           String?
  terms           String?
  dueDate         DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  sentAt          DateTime?
  paidAt          DateTime?

  // Relations
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quote    Quote?   @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  order    Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  user     User?    @relation(fields: [userId], references: [id])
  invoiceLines ProformaInvoiceLine[]

  @@map("proforma_invoices")
}

model ProformaInvoiceLine {
  id          Int      @id @default(autoincrement())
  invoiceId   Int
  productId   Int
  quantity    Int
  unitPrice   Decimal
  totalPrice  Decimal
  size        String?
  color       String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  invoice ProformaInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("proforma_invoice_lines")
}

// ============================================
// PRICING
// ============================================

model ProductPricing {
  id              Int       @id @default(autoincrement())
  productId       Int
  basePrice       Decimal   @default(0)
  discountPercent Decimal?  @default(0)
  finalPrice      Decimal   @default(0)
  validFrom       DateTime  @default(now())
  validUntil      DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_pricing")
}

// ============================================
// INTEGRATIONS
// ============================================

enum IntegrationType {
  E_COMMERCE
  ACCOUNTING
  SHIPPING
  MARKETING
  ANALYTICS
  OTHER
}

enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
  PENDING
  ERROR
}

model Integration {
  id        Int               @id @default(autoincrement())
  name      String
  type      IntegrationType
  status    IntegrationStatus @default(DISCONNECTED)
  apiKey    String? // Encrypted
  apiSecret String? // Encrypted
  config    Json? // Additional configuration
  lastSync  DateTime?
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@map("integrations")
}

// ============================================
// BUSINESS RULES
// ============================================

enum RuleType {
  INVENTORY
  PRICING
  ORDER
  ALERT
  AUTOMATION
  OTHER
}

enum RuleStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

model Rule {
  id          Int        @id @default(autoincrement())
  name        String
  type        RuleType
  status      RuleStatus @default(ACTIVE)
  description String?
  conditions  Json // Rule conditions as JSON
  actions     Json // Rule actions as JSON
  priority    Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("rules")
}

// ============================================
// ALERTS
// ============================================

enum AlertType {
  LOW_STOCK
  HIGH_STOCK
  ORDER_DELAY
  PAYMENT_ISSUE
  SYSTEM_ERROR
  CUSTOM
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  NEW
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

model Alert {
  id             Int           @id @default(autoincrement())
  type           AlertType
  severity       AlertSeverity @default(MEDIUM)
  status         AlertStatus   @default(NEW)
  title          String
  message        String
  entityType     String? // e.g., "Product", "Order", "Inventory"
  entityId       Int?
  metadata       Json? // Additional alert data
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("alerts")
}

// ============================================
// EXCEPTIONS
// ============================================

enum ExceptionType {
  INVENTORY_MISMATCH
  ORDER_PROCESSING_DELAY
  SHIPMENT_DELAY
  PAYMENT_FAILURE
  DATA_INCONSISTENCY
  SYSTEM_ERROR
  CUSTOM
}

enum ExceptionStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Exception {
  id         Int             @id @default(autoincrement())
  type       ExceptionType
  status     ExceptionStatus @default(OPEN)
  title      String
  message    String
  location   String? // e.g., "Warehouse 1", "Order #123"
  entityType String? // e.g., "Product", "Order", "Inventory"
  entityId   Int?
  metadata   Json? // Additional exception data
  resolvedAt DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@map("exceptions")
}

// ============================================
// REPLENISHMENT
// ============================================

enum ReplenishmentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Replenishment {
  id            Int                 @id @default(autoincrement())
  productId     Int
  warehouseId   Int
  quantity      Int
  status        ReplenishmentStatus @default(PENDING)
  reorderPoint  Int
  safetyStock   Int
  requestedDate DateTime            @default(now())
  completedDate DateTime?
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  // Relations
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@map("replenishments")
}

// ============================================
// AUDIT LOGS
// ============================================

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  VIEW
  EXPORT
}

model AuditLog {
  id         Int         @id @default(autoincrement())
  userId     Int
  action     AuditAction
  entityType String // e.g., "Product", "Order", "Inventory"
  entityId   Int?
  changes    Json? // Store before/after changes
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

// ============================================
// REVIEWS & RATINGS
// ============================================

enum ReviewStatus {
  PENDING
  RESPONDED
  RESOLVED
}

model Review {
  id         Int          @id @default(autoincrement())
  customerId Int
  productId  Int?
  rating     Int // 1-5 stars
  review     String
  status     ReviewStatus @default(PENDING)
  source     String? // e.g., "Website", "Google", "App Store", etc.
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  // Relations
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("reviews")
}

// ============================================
// TASKS
// ============================================

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model Task {
  id          Int          @id @default(autoincrement())
  title       String
  description String?
  status      TaskStatus   @default(PENDING)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  category    String?
  assignedTo  String? // User email or name
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("tasks")
}

// ============================================
// SIZE & FIT
// ============================================

model SizeChart {
  id          Int      @id @default(autoincrement())
  name        String
  category    String? // e.g., "Tops", "Bottoms", "Shoes", "Accessories"
  description String?
  measurements Json   // Store size measurements as JSON: { "XS": { "Chest": "34", "Waist": "28", ... }, "S": {...}, ... }
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("size_charts")
}

// ============================================
// SUSTAINABILITY & COMPLIANCE
// ============================================

model DigitalProductPassport {
  id                Int      @id @default(autoincrement())
  productId          Int      @unique
  passportId         String?  @unique // Unique passport identifier
  manufacturerName   String?
  manufacturerAddress String?
  countryOfOrigin    String?
  productionDate     DateTime?
  materials          Json?    // Array of materials with percentages: [{ "name": "Cotton", "percentage": 60 }, ...]
  certifications     String[] // Array of certification IDs (e.g., "GOTS", "OEKO-TEX", "Cradle to Cradle")
  carbonFootprint    Decimal? // CO2 equivalent in kg
  waterFootprint     Decimal? // Water usage in liters
  recyclability      String?  // e.g., "Fully Recyclable", "Partially Recyclable", "Not Recyclable"
  repairability      String?  // e.g., "Easy", "Moderate", "Difficult"
  careInstructions   String?
  disposalInstructions String?
  traceabilityData   Json?    // Supply chain traceability information
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("digital_product_passports")
}

enum ComplianceEvidenceType {
  CERTIFICATION
  TEST_REPORT
  MATERIAL_SAFETY
  ENVIRONMENTAL_IMPACT
  SUPPLY_CHAIN
  OTHER
}

model ComplianceEvidence {
  id          Int                    @id @default(autoincrement())
  productId   Int?
  name        String
  type        ComplianceEvidenceType @default(OTHER)
  description String?
  documentUrl String?                 // URL to the compliance document
  issuer      String?                 // Organization that issued the evidence
  issueDate   DateTime?
  expiryDate  DateTime?
  certificateNumber String?            // Certificate or document number
  standards   String[]                // Array of standards (e.g., ["REACH", "RoHS", "CE"])
  tags        String[]                // Additional tags for categorization
  isActive    Boolean                 @default(true)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  // Relations
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("compliance_evidences")
}

// ============================================
// SALES REPS & TERRITORIES
// ============================================

model SalesRepTerritory {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  name        String
  region      String?  // e.g., "North America", "Europe", "Asia-Pacific"
  countries   String[] // Array of country codes or names
  states      String[] // Array of state/province names (optional)
  cities      String[] // Array of city names (optional)
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sales_rep_territories")
}

enum CommissionType {
  SALES_VOLUME
  MARGIN
  HYBRID
}

enum CommissionStatus {
  PENDING
  CALCULATED
  APPROVED
  PAID
}

model SalesRepCommission {
  id              Int             @id @default(autoincrement())
  userId          Int
  period          String          // e.g., "2024-01", "2024-Q1"
  type            CommissionType  @default(SALES_VOLUME)
  salesAmount     Decimal         @default(0)
  marginAmount    Decimal         @default(0)
  commissionRate  Decimal         // Percentage or fixed rate
  commissionAmount Decimal         @default(0)
  status          CommissionStatus @default(PENDING)
  notes           String?
  calculatedAt    DateTime?
  approvedAt      DateTime?
  paidAt          DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period, type])
  @@map("sales_rep_commissions")
}

// ============================================
// ORGANIZATION SETTINGS - BRANDS & MARKETS
// ============================================

enum BrandStatus {
  ACTIVE
  INACTIVE
}

enum MarketStatus {
  ACTIVE
  INACTIVE
}

model Brand {
  id          Int          @id @default(autoincrement())
  name        String
  code        String       @unique
  description String?
  logo        String?
  status      BrandStatus  @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  brandMarkets BrandMarket[]

  @@map("brands")
}

model Market {
  id        Int          @id @default(autoincrement())
  name      String
  code      String       @unique
  region    String?
  country   String
  currency  String
  language  String
  timezone  String
  status    MarketStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // Relations
  brandMarkets BrandMarket[]
  localizations Localization[]

  @@map("markets")
}

// Many-to-many relationship between Brand and Market
model BrandMarket {
  id        Int      @id @default(autoincrement())
  brandId   Int
  marketId  Int
  createdAt DateTime @default(now())

  // Relations
  brand  Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@unique([brandId, marketId])
  @@map("brand_markets")
}

// ============================================
// LOCALIZATION SETTINGS
// ============================================

enum SizeSystem {
  US
  EU
  UK
  JP
  CN
  AU
}

model Localization {
  id           Int        @id @default(autoincrement())
  marketId     Int        @unique
  language     String
  currency     String
  dateFormat   String     @default("MM/DD/YYYY")
  timeFormat   String     @default("12h")
  numberFormat String     @default("en-US")
  sizeSystem   SizeSystem @default(US)
  weightUnit   String     @default("kg")
  lengthUnit   String     @default("cm")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relations
  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@map("localizations")
}

// ============================================
// API KEYS & WEBHOOKS
// ============================================

enum ApiKeyType {
  API_KEY
  WEBHOOK
}

model ApiKey {
  id          Int        @id @default(autoincrement())
  name        String
  key         String     @unique // Encrypted/hashed key
  type        ApiKeyType
  description String?
  permissions String[]   // Array of permission strings
  lastUsed    DateTime?
  expiresAt   DateTime?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("api_keys")
}

// ============================================
// SYNC HEALTH
// ============================================

enum SyncStatus {
  HEALTHY
  WARNING
  ERROR
  SYNCING
}

model SyncHealth {
  id            Int        @id @default(autoincrement())
  channelId     Int        @unique // Reference to Integration or Channel
  channelName    String
  status        SyncStatus @default(HEALTHY)
  lastSync      DateTime?
  nextSync      DateTime?
  recordsSynced Int        @default(0)
  recordsFailed Int        @default(0)
  syncDuration  Int?      // Duration in seconds
  errorMessage  String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("sync_health")
}

// ============================================
// SYSTEM SETTINGS
// ============================================

enum NumberingRuleType {
  SKU
  EAN
  BARCODE
}

enum NumberingRuleStatus {
  ACTIVE
  INACTIVE
}

model NumberingRule {
  id              Int                  @id @default(autoincrement())
  name            String
  type            NumberingRuleType
  prefix          String?
  suffix          String?
  length          Int                  @default(8)
  sequenceStart   Int                  @default(1)
  currentSequence Int                  @default(1)
  format          String               // e.g., "{prefix}-{sequence}"
  status          NumberingRuleStatus  @default(ACTIVE)
  description     String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@map("numbering_rules")
}

enum TaxType {
  VAT
  SALES_TAX
  GST
}

model TaxDefault {
  id          Int      @id @default(autoincrement())
  name        String
  type        TaxType
  rate        Decimal  // Tax rate as percentage
  country     String
  region      String?
  isDefault   Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tax_defaults")
}

enum WarehouseDefaultStatus {
  ACTIVE
  INACTIVE
}

model WarehouseDefault {
  id          Int                     @id @default(autoincrement())
  name        String
  code        String                  @unique
  address     String
  city        String
  state       String?
  country     String
  postalCode  String
  isDefault   Boolean                 @default(false)
  status      WarehouseDefaultStatus  @default(ACTIVE)
  capacity    Int?
  description String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@map("warehouse_defaults")
}

// ============================================
// ROLES & PERMISSIONS
// ============================================

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  permissions String[] // Array of permission strings (e.g., ["inventory:view", "orders:create"])
  isSystemRole Boolean  @default(false) // System roles cannot be deleted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  users User[]

  @@map("roles")
}

// ============================================
// DATA IMPORTS & EXPORTS
// ============================================

enum DataImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum DataImportType {
  PRODUCTS
  ORDERS
  CUSTOMERS
  INVENTORY
  CUSTOM
}

model DataImport {
  id              Int              @id @default(autoincrement())
  fileName        String
  type            DataImportType   @default(CUSTOM)
  status          DataImportStatus @default(PENDING)
  recordsTotal    Int              @default(0)
  recordsProcessed Int             @default(0)
  recordsFailed   Int              @default(0)
  uploadedBy      String           // User email or name
  uploadedAt      DateTime         @default(now())
  completedAt     DateTime?
  errorMessage    String?
  fileUrl         String?          // Path to uploaded file
  filePath        String?          // Server file path
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("data_imports")
}

enum DataExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum DataExportType {
  PRODUCTS
  ORDERS
  CUSTOMERS
  INVENTORY
  CUSTOM
}

enum DataExportFormat {
  CSV
  EXCEL
}

model DataExport {
  id            Int              @id @default(autoincrement())
  name          String
  format        DataExportFormat @default(CSV)
  type          DataExportType   @default(CUSTOM)
  status        DataExportStatus @default(PENDING)
  recordsCount  Int              @default(0)
  fileSize      Int?             // File size in bytes
  createdBy     String           // User email or name
  createdAt     DateTime         @default(now())
  completedAt   DateTime?
  errorMessage  String?
  fileUrl       String?          // Path to exported file
  filePath      String?          // Server file path
  updatedAt     DateTime         @updatedAt

  @@map("data_exports")
}
